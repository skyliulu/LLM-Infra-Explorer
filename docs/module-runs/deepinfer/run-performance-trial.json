  "claims": [
    {
      "id": "reuse",
      "statement": "Shared history reduces repeated input processing, with model-specific decoder replay and storage/transfer costs.",
      "source": "https://github.com/deepseek-ai/DeepInfer/blob/553741557a57df44a46fb3ab72b6aafeaf945337/doc/inference_deployment_qa.md",
      "locator": "KV cache storage and KV cache hits and recomputation",
      "boundary": "Coverage counter is not time/FLOPs or a real100% runtime hit promise.",
      "model": "1000 positions divided into reused/remaining",
      "trigger": "Move reusable fraction0→100",
      "expected": "Remaining1000→0 while baseline stays1000",
      "checkIds": [
        "model",
        "browser",
        "visual"
      ]
    },
    {
      "id": "wide",
      "statement": "Larger expert groups partition weights more finely and amortize each weight over more tokens; EPLB addresses a distinct slow-rank bottleneck.",
      "source": "https://github.com/deepseek-ai/DeepInfer/blob/553741557a57df44a46fb3ab72b6aafeaf945337/doc/inference_deployment_qa.md",
      "locator": "Inference system overview; Expert-parallel load balancing",
      "boundary": "Eight toy GPUs/eight equal experts32tokens, uniform top1 and ideal one read per expert per step; not measured HBM or speed.",
      "model": "EP2/8 preserves32 jobs and4 jobs/rank; weight units32/8",
      "trigger": "Select EP2/8 and toggle hotspot distribution",
      "expected": "Expert set topology changes; local weights4/1; reuse1/4; max work16/9 at total32",
      "checkIds": [
        "model",
        "browser",
        "visual"
      ]
    },
    {
      "id": "capacity",
      "statement": "P/D resource allocation and asynchronous CPU/device execution reduce different waiting costs.",
      "source": "https://github.com/deepseek-ai/DeepInfer/blob/553741557a57df44a46fb3ab72b6aafeaf945337/doc/inference_deployment_qa.md",
      "locator": "Inference system overview; Data-parallel load balancing; Asynchronous scheduling",
      "boundary": "Eight allocation shares are not physical GPUs; timing values are assumed1/4/1/2.",
      "model": "Independent phase pools plus existing dependency model",
      "trigger": "Select traffic and inspect timing/trace",
      "expected": "Pools6:2 or2:6; no invented full-system speedup",
      "checkIds": [
        "model",
        "browser",
        "visual"
      ]
    },
    {
      "id": "economics",
      "statement": "Reported38USD/GPU-hour is production revenue; recovery depends on capital and net operating cash.",
      "source": "https://github.com/deepseek-ai/DeepInfer/blob/553741557a57df44a46fb3ab72b6aafeaf945337/doc/inference_deployment_qa.md",
      "locator": "Introduction and README release boundary",
      "boundary": "Illustrative CAPEX/expense/revenue fraction; constant24h, excludes financing/tax/residual value; no official one-month promise in inspected sources.",
      "model": "capital/[24*(realized revenue-expense)], undefined when denominator<=0",
      "trigger": "Set revenue0 or hourly expense50",
      "expected": "No finite recovery at nonpositive cash; default scenario720/day and41.67days",
      "checkIds": [
        "model",
        "browser",
        "visual"
      ]
    }
  ],
