  "claims": [
    {
      "id": "hierarchy",
      "statement": "Serving context, engine responsibilities and model execution are distinct levels connected by concrete input/output ownership.",
      "source": "https://github.com/deepseek-ai/DeepInfer/blob/553741557a57df44a46fb3ab72b6aafeaf945337/deepinfer/engine/llm_engine.py#L860",
      "locator": "LLMEngine.step; worker/model runtime and official serving Q&A",
      "boundary": "A responsibility hierarchy, not a literal serial trace of asynchronous code or a complete public online deployment.",
      "model": "FRAMEWORK parent/children and deriveFrameworkView",
      "trigger": "Open execution, inspect a leaf, return directly or stepwise to ancestors",
      "expected": "Parent context and containing branch stay aligned; service/engine/execution expose distinct responsibilities.",
      "checkIds": [
        "research",
        "model",
        "browser"
      ]
    },
    {
      "id": "request-progress",
      "statement": "Scheduling chooses work before computation; partial prefill emits no token, and committing a sampled result updates request state.",
      "source": "https://github.com/deepseek-ai/DeepInfer/blob/553741557a57df44a46fb3ab72b6aafeaf945337/csrc/engine/scheduler.hpp#L351",
      "locator": "_schedule_prefill plus model/worker output processing",
      "boundary": "One-rank synchronous NORMAL, nextn0, two toy generation slots, sufficient cache and interval1.",
      "model": "buildRequestTrace/deriveDeepInferState with schedule-vs-partial regression",
      "trigger": "Step through schedule A, forward B, sample and commit",
      "expected": "ScheduleA is not yet computed; partialB retains history without output; sampleA pending1 then commitA output1.",
      "checkIds": [
        "research",
        "model",
        "browser"
      ]
    },
    {
      "id": "async",
      "statement": "CPU work can overlap device execution while prior sample remains a prerequisite of the next forward.",
      "source": "https://github.com/deepseek-ai/DeepInfer/blob/553741557a57df44a46fb3ab72b6aafeaf945337/deepinfer/worker/worker.py#L89",
      "locator": "Worker.batch_inference and final drain",
      "boundary": "Assumed time units1/4/1/2; no GPU measurement or predicted speedup.",
      "model": "deriveOverlapModel and scoped timing selection",
      "trigger": "Toggle sync/async and select a timing operation",
      "expected": "Baseline/candidate selection resolves its own operation; dependency remains and the final result drains.",
      "checkIds": [
        "research",
        "model",
        "browser"
      ]
    }
  ],
