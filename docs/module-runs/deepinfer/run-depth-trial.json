  "claims": [
    {
      "id": "moe-dispatch",
      "statement": "Mega and separated MoE are exclusive dispatch paths constrained by platform, supported precision and NVLink domain.",
      "source": "https://github.com/deepseek-ai/DeepInfer/blob/553741557a57df44a46fb3ab72b6aafeaf945337/deepinfer/model_executor/models/v4_modules/mlp.py#L184",
      "locator": "DeepseekMoE.__init__, forward",
      "boundary": "Predicate probe only; independent Boolean inputs do not assert arbitrary hardware configurations are deployable. Library call is not one hardware kernel.",
      "model": "deriveMoeDispatch",
      "trigger": "Change GPU/domain/precision",
      "expected": "Within-domain GPU supported path selects Mega; outside-domain or non-GPU BF16 selects separate.",
      "checkIds": [
        "research",
        "model",
        "browser"
      ]
    },
    {
      "id": "verification-budget",
      "statement": "Under a fixed extra-row budget, cumulative confidence products allocate prefix verification rows while mandatory main rows remain.",
      "source": "https://github.com/deepseek-ai/DeepInfer/blob/553741557a57df44a46fb3ab72b6aafeaf945337/csrc/engine/mtp_varlen.hpp",
      "locator": "MTPVarlen.schedule and schedule_mtp_varlen device path",
      "boundary": "Three requests / three drafts; full implementation additionally chooses budget from hardware cost curves and uses delayed/newer confidence. Selected is not accepted.",
      "model": "deriveVerificationAllocation with exhaustive prefix oracle",
      "trigger": "Budget0/9 and varied/low confidence",
      "expected": "Extra selections0/9, total query rows3/12; prefix property and expected contribution verified.",
      "checkIds": [
        "research",
        "model",
        "browser"
      ]
    },
    {
      "id": "cache-record",
      "statement": "Main/SWA/index formats have distinct value and scale byte costs.",
      "source": "https://github.com/deepseek-ai/DeepInfer/blob/553741557a57df44a46fb3ab72b6aafeaf945337/deepinfer/model_executor/layers/tilelang_ops/cache_common.py#L119",
      "locator": "V41_FP4_FORMAT, V41_FORMAT, FP4_INDEX_KV_FORMAT",
      "boundary": "Single record, no additional alignment/metadata/layers/tokens; index data/scale block layout is not a token-interleaved byte animation.",
      "model": "deriveCacheRecord",
      "trigger": "Select Main/SWA/Indexer",
      "expected": "288 / 528 / 68 bytes; separate value and scale accounting.",
      "checkIds": [
        "research",
        "model",
        "browser"
      ]
    },
    {
      "id": "first-output",
      "statement": "Partial prefill emits no output; final prompt chunk can sample the first output and CPU commit updates committed count.",
      "source": "https://github.com/deepseek-ai/DeepInfer/blob/553741557a57df44a46fb3ab72b6aafeaf945337/csrc/engine/scheduler.hpp#L351",
      "locator": "_schedule_prefill plus worker sampling/commit",
      "boundary": "Synchronous NORMAL one-rank nextn0 sufficient blocks, teaching interval1 and two slots.",
      "model": "buildRequestTrace / deriveDeepInferState",
      "trigger": "Mixed budget8, seek sample then commit",
      "expected": "A pending1 committed0; B partial2/4 pending0; commit increments A only.",
      "checkIds": [
        "research",
        "model",
        "browser"
      ]
    },
    {
      "id": "overlap-dependency",
      "statement": "Async work preserves prior-sample to next-forward dependency and needs final drain.",
      "source": "https://github.com/deepseek-ai/DeepInfer/blob/553741557a57df44a46fb3ab72b6aafeaf945337/deepinfer/worker/worker.py#L89",
      "locator": "Worker.batch_inference, flush_inflight_reqs",
      "boundary": "Dimensionless assumed timing, not benchmark or full ZOS implementation.",
      "model": "deriveOverlapModel",
      "trigger": "Toggle async and inspect baseline commit operation",
      "expected": "Sync/async dependent schedules; baseline selection resolves its own track.",
      "checkIds": [
        "research",
        "model",
        "browser"
      ]
    }
  ],
